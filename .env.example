# =====================================================================
# IBM Quantum & IBM Cloud Configuration for Predictive Maintenance
# =====================================================================

# 1. IBM Quantum Platform API Token (Get it at https://quantum.ibm.com/)
IBM_QUANTUM_TOKEN=your_ibm_quantum_api_token_here

# 2. IBM Quantum Channel ('ibm_quantum' for open plan, 'ibm_cloud' for IBM Cloud instances)
IBM_QUANTUM_CHANNEL=ibm_quantum

# 3. Target Quantum Device / Backend (e.g., 'ibm_brisbane', 'ibm_kyiv', 'ibmq_qasm_simulator')
IBM_QUANTUM_BACKEND=ibm_brisbane

# 4. Optional: IBM Cloud IAM API Key & Watson Machine Learning Credentials
IBM_CLOUD_API_KEY=your_ibm_cloud_iam_api_key_here
IBM_CLOUD_IAM_TOKEN=
IBM_WML_URL=https://us-south.ml.cloud.ibm.com
IBM_WML_PROJECT_ID=your_ibm_cloud_project_id_here
